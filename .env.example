# Copy to .env and supply your own local database credentials.
DATABASE_URL=postgresql://postgres:local-test-only@127.0.0.1:55432/threat_insight_test
PORT=3000
LOG_LEVEL=log,warn,error

# Disable bootstrap and scheduled collection until you are ready to ingest NVD.
CVE_JOBS_ENABLED=false
NVD_API_KEY=

# Leave empty to disable the administrative normalization endpoint (503).
# Configure a strong random value in your environment; do not commit it.
ADMIN_API_KEY=
